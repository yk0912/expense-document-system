# Gemini（Google AI Studio）
GEMINI_API_KEY=
# レシート読み取り向けの軽量モデル。精度優先なら gemini-3.6-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# 思考レベル。未指定は low（速度と精度のバランス）。minimal / low / medium / high
GEMINI_THINKING_LEVEL=low

# Google OAuth（ウェブ クライアント expense-oauth-playground）
# GOOGLE_REFRESH_TOKEN は 1// で始まる値。4/ で始まる認可コードは使えない
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 税理士指定スプレッドシート / Drive 保存先
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_NAME=経費集計
GOOGLE_CATEGORY_SHEET_NAME=経費区分の説明

# 管理者ログインとシステム設定のロック解除。未指定は admin
ADMIN_PASSWORD=
